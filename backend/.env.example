# Database
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db:5432/teesu

# AdminJS — на проде ОБЯЗАТЕЛЬНО true, иначе /admin открыт всем
ADMIN_AUTH_ENABLED=false
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your_strong_password_here
ADMIN_COOKIE_SECRET=random_32_char_string_here

# Media storage: local (backend/uploads, отдаётся по /uploads) | s3
STORAGE_DRIVER=local

# S3 Storage: медиа при STORAGE_DRIVER=s3 + бэкапы БД (backup.sh, всегда).
# В dev оставлять STORAGE_DRIVER=local, чтобы не писать в прод-бакет.
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=ru1
S3_PUBLIC_URL=https://cloud.tee.su
